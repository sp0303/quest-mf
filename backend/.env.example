QMF_REDIS_URL=redis://:password@localhost:6379/0
QMF_REDIS_STREAM_URL=redis://:password@localhost:6379/1
QMF_JWT_SECRET=quest-mf-jwt-dev-secret-key-replace-with-rsa256-in-prod
